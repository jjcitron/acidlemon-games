# Names only. Never commit values.
#
# MUST be byte-identical to the value the live Sumi project uses, or existing Sumi sessions and
# user ids stop resolving. This signs the shared .acidlemon.com session cookie.
SESSION_SECRET=

# Set this ONCE to whatever SESSION_SECRET currently is. It keys the opaque user id, so pinning it
# separately lets SESSION_SECRET be rotated later without renaming every user and save.
ID_SECRET=

# Mailgun, same account/domain Sumi already sends from (acidlemon.com).
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_FROM=
# Only for EU accounts: https://api.eu.mailgun.net
MAILGUN_API_BASE=

# Vercel Blob public store read-write token.
PUBLIC_READ_WRITE_TOKEN=

# Public origin of this service, e.g. https://id.acidlemon.com
ID_URL=

# Optional. Defaults to .acidlemon.com
COOKIE_DOMAIN=

# Optional. Comma-separated extra CORS origins for preview/local dev.
ACIDLEMON_EXTRA_ORIGINS=
